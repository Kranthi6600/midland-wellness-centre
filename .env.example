# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Midland Wellness Centre

# Contact Information
NEXT_PUBLIC_PHONE=+1 705-527-7770
NEXT_PUBLIC_EMAIL=info@midlandwellness.ca
NEXT_PUBLIC_ADDRESS=Midland, Ontario, Canada

# Business Hours (optional - defaults are in constants)
# MONDAY_HOURS=10:00 AM - 6:00 PM
# TUESDAY_HOURS=10:00 AM - 6:00 PM
# WEDNESDAY_HOURS=10:00 AM - 7:00 PM
# THURSDAY_HOURS=10:00 AM - 6:00 PM
# FRIDAY_HOURS=10:00 AM - 6:00 PM
# SATURDAY_HOURS=12:00 PM - 3:00 PM
# SUNDAY_HOURS=Closed

# Email Service Configuration (choose one provider)
EMAIL_PROVIDER=sendgrid # Options: sendgrid, resend, smtp

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Resend Configuration
# RESEND_API_KEY=your_resend_api_key_here

# SMTP Configuration (for server-side implementation)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Email Settings
EMAIL_FROM=noreply@midlandwellness.ca
EMAIL_TO=info@midlandwellness.ca,admin@midlandwellness.ca

# Database Configuration
DATABASE_TYPE=file # Options: file, mongodb, postgresql

# MongoDB Configuration (if using MongoDB)
# MONGODB_URI=mongodb://localhost:27017/midland-wellness
# MONGODB_DB_NAME=midland_wellness

# PostgreSQL Configuration (if using PostgreSQL)
# DATABASE_URL=postgresql://username:password@localhost:5432/midland_wellness
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=your_username
# POSTGRES_PASSWORD=your_password
# POSTGRES_DB=midland_wellness

# File Database Configuration (if using file storage)
DATABASE_FILE_PATH=./data/contact-submissions.json

# Security Settings
ENABLE_CSRF_PROTECTION=true
ENABLE_RATE_LIMITING=true
ENABLE_INPUT_SANITIZATION=true
MAX_MESSAGE_LENGTH=2000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=5 # Max 5 submissions per 15 minutes
RATE_LIMIT_API_MAX_REQUESTS=100 # Max 100 API requests per 15 minutes

# Allowed Domains for CORS
ALLOWED_DOMAINS=midlandwellness.ca,www.midlandwellness.ca,localhost:3000,127.0.0.1:3000

# Logging Configuration
LOG_LEVEL=info # Options: error, warn, info, debug
ENABLE_MONITORING=true
MAX_LOG_ENTRIES=1000

# Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# VERCEL_ANALYTICS_ID=your_vercel_analytics_id

# Social Media Links
# FACEBOOK_URL=https://facebook.com/midlandwellness
# TWITTER_URL=https://twitter.com/midlandwellness
# INSTAGRAM_URL=https://instagram.com/midlandwellness

# Appointment System
# CALENDAR_API_KEY=your_google_calendar_api_key
# CALENDAR_ID=your_calendar_id

# Security
# NEXTAUTH_SECRET=your_nextauth_secret
# NEXTAUTH_URL=http://localhost:3000

# Development
NODE_ENV=development

# Production Environment Variables
# When deploying to production, ensure:
# - All API keys are set and valid
# - Database connections are configured
# - Email service is working
# - Security settings are appropriate
# - CORS domains are updated to production domain
# - Rate limits are configured for expected traffic
