# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Midland Wellness Centre

# Contact Information
NEXT_PUBLIC_PHONE=+1 705-527-7770
NEXT_PUBLIC_EMAIL=info@midlandwellness.ca
NEXT_PUBLIC_ADDRESS=Midland, Ontario, Canada

# Business Hours (optional - defaults are in constants)
# MONDAY_HOURS=10:00 AM - 6:00 PM
# TUESDAY_HOURS=10:00 AM - 6:00 PM
# WEDNESDAY_HOURS=10:00 AM - 7:00 PM
# THURSDAY_HOURS=10:00 AM - 6:00 PM
# FRIDAY_HOURS=10:00 AM - 6:00 PM
# SATURDAY_HOURS=12:00 PM - 3:00 PM
# SUNDAY_HOURS=Closed

# Email Service (choose one)
# SENDGRID_API_KEY=your_sendgrid_api_key
# RESEND_API_KEY=your_resend_api_key
# SMTP_HOST=your_smtp_host
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password

# Database (optional)
# DATABASE_URL=your_database_connection_string
# MONGODB_URI=your_mongodb_connection_string

# Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# VERCEL_ANALYTICS_ID=your_vercel_analytics_id

# Social Media Links
# FACEBOOK_URL=https://facebook.com/midlandwellness
# TWITTER_URL=https://twitter.com/midlandwellness
# INSTAGRAM_URL=https://instagram.com/midlandwellness

# Appointment System
# CALENDAR_API_KEY=your_google_calendar_api_key
# CALENDAR_ID=your_calendar_id

# Security
# NEXTAUTH_SECRET=your_nextauth_secret
# NEXTAUTH_URL=http://localhost:3000

# Development
NODE_ENV=development
